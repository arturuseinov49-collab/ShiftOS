# Public project URL and publishable key, from Supabase > Connect.
# Leave both empty to run the isolated demo at /demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# disabled is the safe default. mock is allowed only outside production.
AI_PROVIDER=disabled
# Canonical public origin behind the production reverse proxy, without a trailing slash.
# Example only; replace with your own hostname. Leave empty for local development.
APP_ORIGIN=
# No service-role key or provider API key is needed for sprint 1.
